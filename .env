# ---------------------------------------------------------------------------
# PostgreSQL
# ---------------------------------------------------------------------------
# Managed PostgreSQL (Neon). When DATABASE_URL is set it wins outright and the
# discrete DB_* values below are ignored — they remain for a local server.
DATABASE_URL=postgresql://neondb_owner:npg_Uit0kD9Wobhj@ep-proud-king-ayxglx27-pooler.c-5.us-east-2.aws.neon.tech/fashion?sslmode=require&channel_binding=require

DB_NAME=fashion_trendz
DB_USER=postgres
DB_PASSWORD=8328
DB_HOST=localhost
DB_PORT=5432
DB_CONN_MAX_AGE=60
DB_CONNECT_TIMEOUT=10
DB_SSLMODE=prefer

# ---------------------------------------------------------------------------
# Localization
# ---------------------------------------------------------------------------
LANGUAGE_CODE=en-us
TIME_ZONE=UTC

# ---------------------------------------------------------------------------
# REST framework
# ---------------------------------------------------------------------------
API_PAGE_SIZE=20
# Seconds the category tree / mega menu / homepage payload stay cached.
CATALOG_CACHE_TTL=300
# Seconds product homepage rails / facets / trending searches stay cached.
PRODUCT_CACHE_TTL=300

# ---------------------------------------------------------------------------
# Cart money rules
# ---------------------------------------------------------------------------
CART_FREE_SHIPPING_THRESHOLD=999.00
CART_SHIPPING_CHARGE=79.00
CART_PLATFORM_FEE=20.00
THROTTLE_ANON=100/hour
THROTTLE_USER=1000/hour
THROTTLE_LOGIN=10/min
THROTTLE_REGISTER=10/hour
THROTTLE_PASSWORD_RESET=5/hour
THROTTLE_CHECKOUT=30/hour
THROTTLE_BURST=60/min
PASSWORD_MIN_LENGTH=8

# ---------------------------------------------------------------------------
# JWT
# ---------------------------------------------------------------------------
JWT_ACCESS_TOKEN_LIFETIME_MINUTES=15
JWT_REFRESH_TOKEN_LIFETIME_DAYS=7
JWT_ROTATE_REFRESH_TOKENS=True
JWT_BLACKLIST_AFTER_ROTATION=True
JWT_ALGORITHM=HS256
JWT_LEEWAY_SECONDS=0

# ---------------------------------------------------------------------------
# OpenAPI
# ---------------------------------------------------------------------------
ENABLE_API_DOCS=True
API_TITLE=Fashion Trendz API
API_VERSION=1.0.0
API_SERVER_URL=http://127.0.0.1:8000

# ---------------------------------------------------------------------------
# Email & password reset
# ---------------------------------------------------------------------------
# With DEBUG=True this defaults to the console backend: reset emails are
# printed in the runserver terminal, no SMTP account needed.
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=True
EMAIL_TIMEOUT=10
DEFAULT_FROM_EMAIL=Fashion Trendz <no-reply@fashiontrendz.local>
PASSWORD_RESET_TIMEOUT=86400
FRONTEND_URL=http://192.168.0.151:3000

# ---------------------------------------------------------------------------
# CORS (Next.js frontend origins)
# ---------------------------------------------------------------------------
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://192.168.0.151:3000
CORS_ALLOW_CREDENTIALS=True

# ---------------------------------------------------------------------------
# Security (defaults follow DEBUG; override per environment)
# ---------------------------------------------------------------------------
SECURE_SSL_REDIRECT=False
SESSION_COOKIE_SECURE=False
CSRF_COOKIE_SECURE=False
USE_X_FORWARDED_PROTO=False
SESSION_COOKIE_SAMESITE=Lax
CSRF_COOKIE_SAMESITE=Lax

# ---------------------------------------------------------------------------
# Uploads
# ---------------------------------------------------------------------------
DATA_UPLOAD_MAX_MEMORY_SIZE=5242880
FILE_UPLOAD_MAX_MEMORY_SIZE=5242880
DATA_UPLOAD_MAX_NUMBER_FIELDS=1000

# ---------------------------------------------------------------------------
# Logging
# ---------------------------------------------------------------------------
LOG_LEVEL=INFO
SQL_LOG_LEVEL=WARNING
# Per-request access log from ResponseTimeMiddleware. Set to WARNING to keep
# only failures and slow requests.
API_LOG_LEVEL=INFO

# ---------------------------------------------------------------------------
# Payment gateways
# ---------------------------------------------------------------------------
# Leave blank in development: the checkout falls back to cash on delivery and
# /api/v1/payments/gateways/ reports Razorpay as not configured.
PAYMENT_DEFAULT_GATEWAY=razorpay
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# ---------------------------------------------------------------------------
# Reviews
# ---------------------------------------------------------------------------
# Leave False unless someone is staffed to drain the moderation queue.
REVIEW_AUTO_APPROVE=False

# ---------------------------------------------------------------------------
# Recommendations
# ---------------------------------------------------------------------------
# Trending score weights. Documented in apps/recommendations/scoring.py.
TRENDING_WEIGHT_VIEW=1.0
TRENDING_WEIGHT_PURCHASE=3.0
TRENDING_WEIGHT_WISHLIST=2.0
TRENDING_WEIGHT_REVIEW=1.5
TRENDING_WEIGHT_RATING=2.0
TRENDING_WEIGHT_RECENCY=4.0
TRENDING_HALF_LIFE_DAYS=30
TRENDING_RATING_PRIOR=10
RECOMMENDATION_CACHE_TTL=300
MAX_RECENTLY_VIEWED=30

# ---------------------------------------------------------------------------
# Deployment identity
# ---------------------------------------------------------------------------
ENVIRONMENT=development
APP_VERSION=1.0.0

# ---------------------------------------------------------------------------
# Redis and Celery
# ---------------------------------------------------------------------------
# Leave blank for local development: the cache falls back to in-memory and
# notifications deliver inside the request instead of being queued.
REDIS_URL=
CELERY_BROKER_URL=
CELERY_RESULT_BACKEND=
CACHE_KEY_PREFIX=ft
CACHE_DEFAULT_TIMEOUT=300

# ---------------------------------------------------------------------------
# Notifications
# ---------------------------------------------------------------------------
NOTIFICATION_RETENTION_DAYS=180
SMS_BACKEND=apps.notifications.channels.ConsoleSMSChannel
PUSH_BACKEND=apps.notifications.channels.ConsolePushChannel

# ---------------------------------------------------------------------------
# Object storage (blank = local disk)
# ---------------------------------------------------------------------------
AWS_STORAGE_BUCKET_NAME=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_S3_REGION_NAME=ap-south-1
AWS_S3_ENDPOINT_URL=
AWS_S3_CUSTOM_DOMAIN=

# ---------------------------------------------------------------------------
# Throttling for the admin surfaces
# ---------------------------------------------------------------------------
THROTTLE_ANALYTICS=120/hour
THROTTLE_REPORT=30/hour
THROTTLE_NOTIFICATION_QUEUE=20/hour
THROTTLE_PRODUCT_VIEW=600/hour
