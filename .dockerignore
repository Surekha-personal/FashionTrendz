# Keep the build context small and keep secrets out of the image.

.git
.gitignore
.github

# The real one is injected as environment variables. Copying it into the image
# would bake production credentials into every layer, where `docker history`
# can read them.
.env
.env.*
!.env.example

.venv
venv/
__pycache__/
*.py[cod]
*.egg-info/

# Built at image build time, not copied in.
staticfiles/
media/
logs/
*.log

db.sqlite3
*.sqlite3

.pytest_cache/
.coverage
htmlcov/
.mypy_cache/
.ruff_cache/

docs/
README.md
*.md
!requirements.txt

.idea/
.vscode/
.DS_Store
